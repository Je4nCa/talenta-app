rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Requiere que el propio documento del usuario tenga rol == 'superadmin'.
    // Solo se llega a ese rol al crear la cuenta con el código correcto (ver
    // tieneCodigoValido más abajo) — nadie puede cambiar su propio rol
    // después (ver reglas de "update" en /users/{uid}). Los tres roles son
    // 'student' (curso, prueba gratuita), 'facilitador' (acceso completo,
    // sin panel de admin) y 'superadmin' (acceso completo + panel de admin).
    function esAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'superadmin';
    }

    // Códigos promocionales (ver src/modules/auth/constants/promociones.ts —
    // deben mantenerse EXACTAMENTE iguales en ambos archivos). No hay Cloud
    // Function todavía (requeriría plan Blaze); mientras tanto, la regla es
    // lo único que impide que alguien llame a Firestore directamente y se
    // auto-asigne facilitador/superadmin sin el código correcto — mismo
    // nivel de protección que el chequeo actual en el cliente, ni más ni
    // menos, ya que este archivo vive en el mismo repo público que el bundle.
    function tieneCodigoValido(datos) {
      return (datos.rol == 'student') ||
        (datos.rol == 'facilitador' && datos.codigoPromocional == 'TALEFACILITA2026') ||
        (datos.rol == 'superadmin' && datos.codigoPromocional == 'TALENTAADMIN272612');
    }

    match /users/{uid} {
      allow read: if esDueno(uid) || esAdmin();

      allow create: if esDueno(uid) && tieneCodigoValido(request.resource.data);

      // El dueño puede actualizar su perfil, pero no cambiar su propio rol.
      allow update: if esDueno(uid) && request.resource.data.rol == resource.data.rol;
      // Un admin sí puede cambiar el rol de otros (ej. panel de administración).
      allow update: if esAdmin();

      allow delete: if false;

      // Subcolecciones del usuario (course, finances, spiritual, payments,
      // assessments, etc.): solo el dueño lee/escribe; un admin solo lee
      // (para el roster del panel de administración, sin poder modificar
      // datos privados de un estudiante).
      match /{subcoleccion}/{documento=**} {
        allow read, write: if esDueno(uid);
        allow read: if esAdmin();
      }
    }

    // Todo lo que no esté explícitamente permitido arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
